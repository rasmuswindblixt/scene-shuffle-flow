@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* Premium SaaS Color Scheme */
    --background: 255 255 255;
    --foreground: 15 23 42;
    --card: 255 255 255;
    --card-foreground: 15 23 42;
    --popover: 255 255 255;
    --popover-foreground: 15 23 42;
    --primary: 99 102 241;
    --primary-foreground: 255 255 255;
    --primary-glow: 129 140 248;
    --secondary: 241 245 249;
    --secondary-foreground: 15 23 42;
    --muted: 248 250 252;
    --muted-foreground: 100 116 139;
    --accent: 236 254 255;
    --accent-foreground: 15 23 42;
    --destructive: 239 68 68;
    --destructive-foreground: 255 255 255;
    --border: 226 232 240;
    --input: 226 232 240;
    --ring: 99 102 241;
    --radius: 0.75rem;
    
    /* Premium Gradients */
    --gradient-primary: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #06b6d4 100%);
    --gradient-secondary: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    --gradient-hero: linear-gradient(135deg, #6366f1 0%, #8b5cf6 25%, #06b6d4 50%, #10b981 75%, #f59e0b 100%);
    --gradient-premium: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --gradient-glass: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
    
    /* Premium Shadows */
    --shadow-primary: 0 10px 25px -3px rgba(99, 102, 241, 0.1), 0 4px 6px -2px rgba(99, 102, 241, 0.05);
    --shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-glow: 0 0 0 1px rgba(99, 102, 241, 0.05), 0 1px 3px 0 rgba(99, 102, 241, 0.1), 0 1px 2px 0 rgba(99, 102, 241, 0.06);
    --shadow-premium: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    --shadow-glass: inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
    
    /* Sidebar colors */
    --sidebar-background: 255 255 255;
    --sidebar-foreground: 15 23 42;
    --sidebar-primary: 99 102 241;
    --sidebar-primary-foreground: 255 255 255;
    --sidebar-accent: 241 245 249;
    --sidebar-accent-foreground: 15 23 42;
    --sidebar-border: 226 232 240;
    --sidebar-ring: 99 102 241;
  }

  .dark {
    /* Premium Dark Mode */
    --background: 2 6 23;
    --foreground: 248 250 252;
    --card: 15 23 42;
    --card-foreground: 248 250 252;
    --popover: 15 23 42;
    --popover-foreground: 248 250 252;
    --primary: 129 140 248;
    --primary-foreground: 15 23 42;
    --primary-glow: 99 102 241;
    --secondary: 30 41 59;
    --secondary-foreground: 248 250 252;
    --muted: 30 41 59;
    --muted-foreground: 148 163 184;
    --accent: 30 41 59;
    --accent-foreground: 248 250 252;
    --destructive: 248 113 113;
    --destructive-foreground: 15 23 42;
    --border: 30 41 59;
    --input: 30 41 59;
    --ring: 129 140 248;
    
    /* Dark Mode Gradients */
    --gradient-primary: linear-gradient(135deg, #818cf8 0%, #a855f7 50%, #06b6d4 100%);
    --gradient-secondary: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    --gradient-hero: linear-gradient(135deg, #818cf8 0%, #a855f7 25%, #06b6d4 50%, #10b981 75%, #f59e0b 100%);
    --gradient-premium: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --gradient-glass: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
    
    /* Dark Mode Shadows */
    --shadow-primary: 0 10px 25px -3px rgba(129, 140, 248, 0.1), 0 4px 6px -2px rgba(129, 140, 248, 0.05);
    --shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -1px rgba(0, 0, 0, 0.2);
    --shadow-glow: 0 0 0 1px rgba(129, 140, 248, 0.05), 0 1px 3px 0 rgba(129, 140, 248, 0.1), 0 1px 2px 0 rgba(129, 140, 248, 0.06);
    --shadow-premium: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    --shadow-glass: inset 0 1px 0 0 rgba(255, 255, 255, 0.05);
    
    /* Dark Sidebar colors */
    --sidebar-background: 15 23 42;
    --sidebar-foreground: 248 250 252;
    --sidebar-primary: 129 140 248;
    --sidebar-primary-foreground: 15 23 42;
    --sidebar-accent: 30 41 59;
    --sidebar-accent-foreground: 248 250 252;
    --sidebar-border: 30 41 59;
    --sidebar-ring: 129 140 248;
  }
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground;
    font-feature-settings: "rlig" 1, "calt" 1;
  }
}

/* Premium utility classes */
@layer utilities {
  .bg-gradient-premium {
    background: var(--gradient-premium);
  }
  
  .bg-gradient-glass {
    background: var(--gradient-glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  
  .shadow-premium {
    box-shadow: var(--shadow-premium);
  }
  
  .shadow-glass {
    box-shadow: var(--shadow-glass);
  }
  
  .text-gradient {
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .border-gradient {
    border: 1px solid transparent;
    background: linear-gradient(white, white) padding-box,
                var(--gradient-primary) border-box;
  }
  
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
  
  .animate-pulse-slow {
    animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  
  .animate-gradient {
    background-size: 200% 200%;
    animation: gradient 8s ease infinite;
  }
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20px); }
}

@keyframes gradient {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}